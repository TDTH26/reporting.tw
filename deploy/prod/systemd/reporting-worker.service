[Unit]
Description=reporting.tw worker (ack timeouts, re-routing, push, AI triage, video frames)
After=network.target mysql.service reporting-api.service
Requires=mysql.service

[Service]
User=reportingtw
Group=reportingtw
WorkingDirectory=/sites/reporting.tw/src/backend
EnvironmentFile=/sites/reporting.tw/reporting.env
ExecStart=/sites/reporting.tw/src/backend/.venv/bin/python -m uavr.worker
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/sites/reporting.tw/data

[Install]
WantedBy=multi-user.target
