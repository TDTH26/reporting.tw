# /sites/reporting.tw/reporting.env  (chmod 600, owned by reportingtw)
# Generate each secret with: openssl rand -base64 48
UAVR_ENV=prod
UAVR_DATABASE_URL=mysql+asyncmy://reporting:CHANGE_ME_DB_PASSWORD@127.0.0.1:3306/reporting
# Signs staff access tokens. Changing it signs everyone out.
UAVR_JWT_SECRET=
# Keyed hashes of informant tokens, device ids and networks. NEVER change after go-live (old tokens stop working).
UAVR_PEPPER=
# Encrypts defense notes. NEVER change after go-live without re-encrypting.
UAVR_DEV_KEY=
UAVR_DATA_DIR=/sites/reporting.tw/data
UAVR_PUBLIC_API_URL=https://api.reporting.tw
UAVR_TUS_PUBLIC_URL=https://api.reporting.tw/files/
UAVR_TUS_HOOK_SECRET=unused-with-local-tusd
# Apache sets X-Real-IP from Cloudflare's CF-Connecting-IP (see apache/reporting.conf).
UAVR_CLIENT_IP_HEADER=X-Real-IP
UAVR_CORS_ORIGINS='["https://reporting.tw","https://www.reporting.tw","https://console.reporting.tw"]'
# AI triage (Featherless). Empty disables it.
UAVR_FEATHERLESS_API_KEY=
