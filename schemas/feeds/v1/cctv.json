{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reporting.tw/schemas/feeds/v1/cctv.json",
  "title": "CCTV camera directory",
  "description": "Camera locations and stream endpoints for dispatcher verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_id",
    "sent_at",
    "cameras"
  ],
  "properties": {
    "schema": {
      "const": "uavr.feed.cctv/1"
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Stable id of the delivering system"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "cameras": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "camera_id",
          "name",
          "lat",
          "lon"
        ],
        "properties": {
          "camera_id": {
            "type": "string",
            "maxLength": 64
          },
          "name": {
            "type": "string"
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "stream_url": {
            "type": "string",
            "format": "uri"
          },
          "snapshot_url": {
            "type": "string",
            "format": "uri"
          },
          "owner": {
            "type": "string"
          },
          "classification": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2,
            "default": 0
          }
        }
      }
    }
  }
}