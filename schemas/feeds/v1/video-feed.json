{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reporting.tw/schemas/feeds/v1/video-feed.json",
  "title": "Agency video feeds",
  "description": "Registry of agency-operated cameras (coastal, harbour, city). The platform samples frames from snapshot_url for AI detection; stream_url is for dispatcher viewing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_id",
    "sent_at",
    "feeds"
  ],
  "properties": {
    "schema": {
      "const": "uavr.feed.video-feed/1"
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "feeds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feed_id",
          "name",
          "lat",
          "lon"
        ],
        "properties": {
          "feed_id": {
            "type": "string",
            "maxLength": 64
          },
          "name": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "bearing_deg": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 360,
            "description": "Optical axis of a fixed camera"
          },
          "fov_deg": {
            "type": "number",
            "minimum": 1,
            "maximum": 360
          },
          "snapshot_url": {
            "type": "string",
            "format": "uri",
            "description": "Returns a current JPEG frame"
          },
          "stream_url": {
            "type": "string",
            "format": "uri"
          },
          "domains": {
            "type": "array",
            "items": {
              "enum": [
                "aerial",
                "surface",
                "subsurface",
                "shore"
              ]
            },
            "minItems": 1
          },
          "sample_interval_s": {
            "type": "integer",
            "minimum": 30,
            "maximum": 3600,
            "default": 120
          },
          "classification": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2,
            "default": 0
          },
          "active": {
            "type": "boolean",
            "default": true
          }
        }
      }
    }
  }
}