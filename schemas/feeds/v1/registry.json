{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reporting.tw/schemas/feeds/v1/registry.json",
  "title": "CAA drone registry",
  "description": "Upserts of registered drones (full or delta sync).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_id",
    "sent_at",
    "records"
  ],
  "properties": {
    "schema": {
      "const": "uavr.feed.registry/1"
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Stable id of the delivering system"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "serial",
          "status"
        ],
        "properties": {
          "serial": {
            "type": "string",
            "maxLength": 64
          },
          "registration_no": {
            "type": "string",
            "maxLength": 64
          },
          "owner": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "owner_ref": {
                "type": "string",
                "maxLength": 128
              },
              "kind": {
                "enum": [
                  "person",
                  "organisation"
                ]
              }
            }
          },
          "model": {
            "type": "string"
          },
          "manufacturer": {
            "type": "string"
          },
          "mtow_g": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "active",
              "suspended",
              "deregistered"
            ]
          }
        }
      }
    }
  }
}