{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reporting.tw/schemas/feeds/v1/sensor-track.json",
  "title": "RF / radar sensor tracks",
  "description": "Continuous machine-generated drone tracks. One item per track update; send updates at least every 5 s while a track is live.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_id",
    "sent_at",
    "tracks"
  ],
  "properties": {
    "schema": {
      "const": "uavr.feed.sensor-track/1"
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Stable id of the delivering system"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sensor_id",
          "sensor_kind",
          "track_id",
          "points"
        ],
        "properties": {
          "sensor_id": {
            "type": "string",
            "maxLength": 64
          },
          "sensor_kind": {
            "enum": [
              "rf",
              "radar",
              "eo_ir",
              "acoustic",
              "fused"
            ]
          },
          "sensor_position": {
            "type": "object",
            "required": [
              "lat",
              "lon"
            ],
            "properties": {
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            },
            "additionalProperties": false
          },
          "track_id": {
            "type": "string",
            "maxLength": 64
          },
          "status": {
            "enum": [
              "active",
              "coasting",
              "ended"
            ],
            "default": "active"
          },
          "points": {
            "type": "array",
            "minItems": 1,
            "maxItems": 600,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "t",
                "lat",
                "lon"
              ],
              "properties": {
                "t": {
                  "type": "string",
                  "format": "date-time"
                },
                "lat": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "lon": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "alt_m": {
                  "type": "number",
                  "description": "Altitude in metres"
                },
                "alt_ref": {
                  "enum": [
                    "wgs84",
                    "msl",
                    "agl"
                  ],
                  "default": "agl"
                },
                "speed_mps": {
                  "type": "number",
                  "minimum": 0
                },
                "heading_deg": {
                  "type": "number",
                  "minimum": 0,
                  "exclusiveMaximum": 360
                },
                "error_m": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "classification": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "target_type": {
                "enum": [
                  "multirotor",
                  "fixed_wing",
                  "vtol",
                  "bird",
                  "usv",
                  "small_boat",
                  "vessel",
                  "unknown"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "model": {
                "type": "string",
                "maxLength": 64
              },
              "target_domain": {
                "enum": [
                  "aerial",
                  "surface",
                  "subsurface"
                ],
                "default": "aerial",
                "description": "Coastal radars report surface targets"
              }
            }
          },
          "rf": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "frequency_mhz": {
                "type": "number"
              },
              "protocol": {
                "type": "string",
                "maxLength": 32
              },
              "serial": {
                "type": "string",
                "maxLength": 64
              },
              "pilot_position": {
                "type": "object",
                "required": [
                  "lat",
                  "lon"
                ],
                "properties": {
                  "lat": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "lon": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}