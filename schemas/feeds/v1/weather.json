{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reporting.tw/schemas/feeds/v1/weather.json",
  "title": "Weather observations",
  "description": "Surface observations used to weigh sighting reliability.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_id",
    "sent_at",
    "observations"
  ],
  "properties": {
    "schema": {
      "const": "uavr.feed.weather/1"
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Stable id of the delivering system"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "station_id",
          "t",
          "lat",
          "lon"
        ],
        "properties": {
          "station_id": {
            "type": "string",
            "maxLength": 32
          },
          "t": {
            "type": "string",
            "format": "date-time"
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "visibility_m": {
            "type": "number",
            "minimum": 0
          },
          "wind_speed_mps": {
            "type": "number",
            "minimum": 0
          },
          "wind_dir_deg": {
            "type": "number",
            "minimum": 0,
            "maximum": 360
          },
          "precip_mm": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}