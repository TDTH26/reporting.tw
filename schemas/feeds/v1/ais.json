{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reporting.tw/schemas/feeds/v1/ais.json",
  "title": "AIS vessel positions and MDA sensor tracks",
  "description": "Cooperative AIS position reports (identified by mmsi) and non-cooperative maritime-domain-awareness sensor tracks (source_kind 'mda', identified only by track_id).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_id",
    "sent_at",
    "vessels"
  ],
  "properties": {
    "schema": {
      "const": "uavr.feed.ais/1"
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "vessels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "t",
          "lat",
          "lon"
        ],
        "properties": {
          "mmsi": {
            "type": "string",
            "pattern": "^[0-9]{9}$"
          },
          "imo": {
            "type": "string",
            "pattern": "^[0-9]{7}$"
          },
          "name": {
            "type": "string",
            "maxLength": 64
          },
          "callsign": {
            "type": "string",
            "maxLength": 16
          },
          "ship_type": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "flag": {
            "type": "string",
            "pattern": "^[A-Z]{2,3}$"
          },
          "length_m": {
            "type": "number",
            "minimum": 0
          },
          "t": {
            "type": "string",
            "format": "date-time"
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "sog_kn": {
            "type": "number",
            "minimum": 0,
            "maximum": 102.3
          },
          "cog_deg": {
            "type": "number",
            "minimum": 0,
            "maximum": 360
          },
          "heading_deg": {
            "type": "number",
            "minimum": 0,
            "maximum": 511
          },
          "nav_status": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "source_kind": {
            "enum": [
              "ais",
              "mda"
            ],
            "default": "ais"
          },
          "track_id": {
            "type": "string",
            "maxLength": 64,
            "description": "Stable track id when there is no MMSI (MDA sensors)"
          },
          "role": {
            "enum": [
              "mobile_asset",
              "fixed_site",
              "ambiguous"
            ],
            "description": "MDA classification of the contact"
          },
          "role_confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        },
        "anyOf": [
          {
            "required": [
              "mmsi"
            ]
          },
          {
            "required": [
              "track_id"
            ]
          }
        ]
      }
    }
  }
}