{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reporting.tw/schemas/feeds/v1/adsb.json",
  "title": "ADS-B manned traffic",
  "description": "Aircraft state vectors (e.g. from an ANSP or receiver network). Send every 1-5 s.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_id",
    "sent_at",
    "states"
  ],
  "properties": {
    "schema": {
      "const": "uavr.feed.adsb/1"
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Stable id of the delivering system"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "icao24",
          "t",
          "lat",
          "lon"
        ],
        "properties": {
          "icao24": {
            "type": "string",
            "pattern": "^[0-9a-f]{6}$"
          },
          "callsign": {
            "type": "string",
            "maxLength": 8
          },
          "t": {
            "type": "string",
            "format": "date-time"
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "alt_baro_m": {
            "type": "number"
          },
          "alt_geo_m": {
            "type": "number"
          },
          "ground_speed_mps": {
            "type": "number",
            "minimum": 0
          },
          "track_deg": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 360
          },
          "on_ground": {
            "type": "boolean",
            "default": false
          }
        }
      }
    }
  }
}